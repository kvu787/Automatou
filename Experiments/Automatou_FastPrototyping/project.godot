; Native, self-contained Godot .NET experiment.
config_version=5

[application]
config/name="Automatou - World laboratory"
run/main_scene="res://Main.tscn"
run/max_fps=60
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[dotnet]
project/assembly_name="Automatou"

[rendering]
renderer/rendering_method="forward_plus"
rendering_device/driver.windows="d3d12"
rendering_device/fallback_to_vulkan=false
rendering_device/fallback_to_opengl3=false
anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.031, 0.047, 0.071, 1)
