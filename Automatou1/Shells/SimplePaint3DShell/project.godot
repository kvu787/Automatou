; Godot 4.7.2 .NET project. The scene tree and styling are code-authored for reviewability.
config_version=5

[application]

config/name="SimplePaint3DShell"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://Icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/driver.windows="d3d12"
rendering_device/fallback_to_vulkan=false
rendering_device/fallback_to_opengl3=false
environment/defaults/default_clear_color=Color(0.027, 0.043, 0.071, 1)

[gui]

theme/default_font_multichannel_signed_distance_field=true

[input]

advance_turn={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32,"unicode":32), Object(InputEventKey,"physical_keycode":4194309)]
}

[dotnet]

project/assembly_name="SimplePaint3DShell"
