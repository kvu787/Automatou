[application]
config/name="Rectangular Grid Motion"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
[display]
window/size/viewport_width=920
window/size/viewport_height=810
window/stretch/mode="canvas_items"
[rendering]
renderer/rendering_method="forward_plus"
rendering_device/driver.windows="d3d12"
rendering_device/fallback_to_vulkan=false
rendering_device/fallback_to_opengl3=false
environment/defaults/default_clear_color=Color(0.035, 0.05, 0.08, 1)

